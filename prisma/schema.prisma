generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  CUSTOMER
  EMPLOYEE
}

enum EmployeeRole {
  ADMIN
  MANAGER
  ATTENDANT
  KITCHEN
  CASHIER
  MOTOBOY
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  PICKED_UP
  DELIVERED
  FINISHED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  PIX
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum DeliveryMode {
  PICKUP       // Retirada no local (como é hoje)
  DELIVERY     // Entrega no endereço do cliente
}

enum DeliveryStatus {
  PENDING          // Aguardando sair (preparado, sem motoboy atribuído)
  ASSIGNED         // Motoboy atribuído, ainda na loja
  OUT_FOR_DELIVERY // A caminho
  ARRIVED          // Chegou no endereço
  DELIVERED        // Entregue
  FAILED           // Não conseguiu (cliente ausente, etc)
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum InstallmentFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
}

enum BillCategory {
  SUPPLIER         // Fornecedor (insumos, bebidas etc.)
  EMPLOYEE         // Salário, vale, adiantamento
  RENT             // Aluguel
  ENERGY           // Energia
  WATER            // Água
  INTERNET         // Internet / telefone
  TAX              // Impostos
  MARKETING        // Marketing / anúncios
  MAINTENANCE      // Manutenção / reparos
  OTHER            // Outros
}

enum PayableMethod {
  CASH
  CARD
  PIX
  BANK_TRANSFER
  BOLETO
  OTHER
}

enum PayableType {
  PAYABLE      // contas a pagar
  RECEIVABLE   // contas a receber
}

enum PaymentProvider {
  MANUAL     // pagamento manual (sem gateway)
  ASAAS      // integração Asaas
  PAGBANK    // (futuro) integração PagBank
}

enum PaymentProviderStatus {
  PENDING
  AUTHORIZED
  PAID
  DECLINED
  CANCELED
  REFUNDED
  IN_ANALYSIS
  EXPIRED
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  OPENING
  CLOSING
  INCOME
  EXPENSE
  WITHDRAWAL
  SUPPLY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PAYMENT
  CASH_CLOSE
  SETTINGS_CHANGE
  STATUS_CHANGE
  PERMISSION_CHANGE
  CAMPAIGN_CREATED
  CAMPAIGN_SENT
  CAMPAIGN_CANCELLED
  CAMPAIGN_DELETED
}

model User {
  id              String        @id @default(uuid())
  userType        UserType
  name            String
  phone           String?
  email           String?       @unique
  login           String?       @unique
  password        String
  role            EmployeeRole?
  active          Boolean       @default(true)
  resetToken      String?
  resetTokenExpires DateTime?
  lastLogin       DateTime?
  defaultObservation String?    @db.VarChar(500)
  taxId             String?    @db.VarChar(18)
  avatarUrl         String?    @db.VarChar(2048)
  vehiclePlate      String?
  vehicleModel      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  orders          Order[]
  addresses       Address[]
  deliveries      Delivery[]    @relation("MotoboyDeliveries")
  ordersDiscounted Order[]       @relation("OrderDiscountBy")
  payablesCreated Payable[]     @relation("PayableCreator")
  receivables     Receivable[]
  receivablesCreated Receivable[] @relation("ReceivableCreator")
  notifications   Notification[]
  auditLogs       AuditLog[]
  cashRegisters   CashRegister[]   @relation("CashRegisterOpenedBy")
  cashRegisterCloses CashRegister[] @relation("CashRegisterClosedBy")
  cashMovements   CashMovement[]
  orderHistory    OrderHistory[]
  paymentsConfirmed Payment[]     @relation("PaymentConfirmedBy")
  pricingRuns       PricingRun[]        @relation("PricingRuns")
  campaignsCreated  Campaign[]          @relation("CampaignsCreated")
  campaignRecipients CampaignRecipient[] @relation("CampaignRecipients")

  @@index([userType])
  @@index([phone])
  @@index([email])
  @@index([taxId])
  @@index([active])
}

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@index([active, order])
}

model Product {
  id          String    @id @default(uuid())
  name        String
  description String?
  price       Float
  categoryId  String
  imageUrl    String?
  featured    Boolean   @default(false)
  order       Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]
  pricingItems PricingRunItem[]
  pricingCost PricingCost?

  @@index([categoryId, active, order])
  @@index([active, featured])
}

model Order {
  id            String        @id @default(uuid())
  number        Int           @unique @default(autoincrement())
  customerId    String
  status        OrderStatus   @default(NEW)
  subtotal      Float
  total         Float
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  observation   String?
  // === Delivery ===
  deliveryMode  DeliveryMode  @default(PICKUP)
  deliveryFee   Float         @default(0)
  // === Desconto de finalização (não fiscal) ===
  discount         Float        @default(0)
  discountReason   String?
  discountByUserId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer      User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  history       OrderHistory[]
  payment       Payment?
  paymentIntent PaymentIntent?
  cashMovement  CashMovement?
  delivery      Delivery?
  discountBy    User?         @relation("OrderDiscountBy", fields: [discountByUserId], references: [id], onDelete: SetNull)
  receivable    Receivable?

  @@index([status, createdAt])
  @@index([customerId, status])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([deliveryMode, status])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String?
  productName String
  unitPrice   Float
  quantity    Int
  subtotal    Float

  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderHistory {
  id          String      @id @default(uuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  userId      String?
  createdAt   DateTime    @default(now())

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String        @unique
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amount      Float
  confirmedAt DateTime?
  confirmedBy String?
  createdAt   DateTime      @default(now())

  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  whoConfirmed User?        @relation("PaymentConfirmedBy", fields: [confirmedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([confirmedAt])
}

model PaymentIntent {
  id              String         @id @default(uuid())
  orderId         String         @unique
  provider        PaymentProvider @default(ASAAS)
  providerPaymentId String?      // ID da cobrança no provider
  providerChargeId  String?      // ID da transação específica
  status          PaymentProviderStatus @default(PENDING)
  method          PaymentMethod?
  amount          Float
  qrCodeBase64    String?        // PIX: QR base64 para <img>
  qrCodeText      String?        // PIX: copia-e-cola
  pixExpiresAt    DateTime?
  invoiceUrl      String?        // link da fatura
  paidAt          DateTime?
  rawLastResponse Json?          // última resposta bruta do provider
  createdAt       DateTime       @default(now())
  updatedAt      DateTime        @updatedAt

  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events          PaymentEvent[]

  @@index([status])
  @@index([providerPaymentId])
  @@index([providerChargeId])
}

model PaymentEvent {
  id          String   @id @default(uuid())
  intentId    String
  type        String   // payment.created, payment.paid, payment.failed, webhook
  rawPayload  Json?
  createdAt   DateTime @default(now())

  intent      PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([intentId, createdAt])
}

model CashRegister {
  id            String            @id @default(uuid())
  openedAt      DateTime          @default(now())
  closedAt      DateTime?
  openingAmount Float
  closingAmount Float?
  expectedAmount Float?
  difference    Float?
  status        CashRegisterStatus @default(OPEN)
  notes         String?
  openedBy      String
  closedBy      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  openedByUser  User              @relation("CashRegisterOpenedBy", fields: [openedBy], references: [id], onDelete: Restrict)
  closedByUser  User?             @relation("CashRegisterClosedBy", fields: [closedBy], references: [id], onDelete: SetNull)
  movements     CashMovement[]

  @@index([status, openedAt])
}

model CashMovement {
  id             String           @id @default(uuid())
  cashRegisterId String
  type           CashMovementType
  amount         Float
  description    String?
  paymentMethod  PaymentMethod?
  orderId        String?          @unique
  userId         String
  createdAt      DateTime         @default(now())

  cashRegister   CashRegister     @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  order          Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([cashRegisterId, createdAt])
  @@index([type])
  @@index([paymentMethod])
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  label         String?  // "Casa", "Trabalho", etc
  recipientName String?
  street        String
  number        String
  complement    String?
  neighborhood  String
  city          String
  state         String
  zipCode       String
  lat           Float
  lng           Float
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
}

model Delivery {
  id              String         @id @default(uuid())
  orderId         String         @unique
  motoboyId       String?
  mode            DeliveryMode
  status          DeliveryStatus @default(PENDING)
  // snapshot do endereço (caso o cliente altere depois)
  addressSnapshot Json
  distanceKm      Float?
  fee             Float          @default(0)
  assignedAt      DateTime?
  pickedUpAt      DateTime?
  arrivedAt       DateTime?
  deliveredAt     DateTime?
  failedReason    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  motoboy         User?          @relation("MotoboyDeliveries", fields: [motoboyId], references: [id], onDelete: SetNull)
  locations       DeliveryLocation[]

  @@index([status])
  @@index([motoboyId, status])
  @@index([orderId])
}

model DeliveryLocation {
  id          String   @id @default(uuid())
  deliveryId  String
  lat         Float
  lng         Float
  accuracy    Float?
  speed       Float?
  heading     Float?
  recordedAt  DateTime @default(now())

  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, recordedAt])
}

model DeliverySettings {
  id              String   @id @default("default")
  deliveryEnabled Boolean   @default(true)
  baseFee         Float     @default(5.00)
  feePerKm        Float     @default(1.50)
  minFee          Float     @default(5.00)
  maxFee          Float     @default(30.00)
  maxDistanceKm   Float     @default(15.00)
  avgSpeedKmh     Float     @default(25.00)
  updatedAt       DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  type      String   @default("ORDER_STATUS")
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model BusinessHours {
  id        String   @id @default(uuid())
  dayOfWeek Int @unique
  open      Boolean  @default(true)
  openTime  String   @default("10:00")
  closeTime String   @default("22:00")

  @@index([open])
}

model Settings {
  id                String  @id @default("default")
  storeName         String  @default("Meu Estabelecimento")
  logoUrl           String?
  cnpj              String?
  phone             String?
  whatsapp          String?
  email             String?
  address           String?
  number            String?
  complement        String?
  neighborhood      String?
  city              String?
  state             String?
  zipCode           String?
  prepTimeMinutes   Int     @default(30)
  isManuallyOpen    Boolean?
  receiptMessage    String?
  receiptFooter     String?
  printTemplateId   String? @default("thermal80")
  updatedAt         DateTime @updatedAt
}

model Payable {
  id           String       @id @default(uuid())
  description  String
  supplier     String?
  category     BillCategory @default(OTHER)
  totalAmount  Float
  issueDate    DateTime     @default(now())
  notes        String?
  createdById  String
  paidAt       DateTime?
  paidAmount   Float        @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  installments Installment[] @relation("PayableInstallments")
  createdBy    User         @relation("PayableCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([issueDate])
  @@index([category])
}

model Receivable {
  id           String       @id @default(uuid())
  description  String
  customerId   String?      // se veio de um cliente cadastrado
  orderId      String?      @unique // se veio de um pedido
  totalAmount  Float
  issueDate    DateTime     @default(now())
  notes        String?
  createdById  String
  paidAt       DateTime?
  paidAmount   Float        @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  installments Installment[] @relation("ReceivableInstallments")
  customer     User?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("ReceivableCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([issueDate])
  @@index([customerId])
}

model Installment {
  id             String         @id @default(uuid())
  parentType     PayableType
  payableId      String?
  receivableId   String?
  number         Int           // 1, 2, 3...
  amount         Float
  paidAmount     Float         @default(0)
  status         InstallmentStatus @default(PENDING)
  dueDate        DateTime
  paidAt         DateTime?
  paymentMethod  PayableMethod?
  notes          String?
  attachmentUrl  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payable        Payable?      @relation("PayableInstallments", fields: [payableId], references: [id], onDelete: Cascade)
  receivable     Receivable?   @relation("ReceivableInstallments", fields: [receivableId], references: [id], onDelete: Cascade)

  @@index([dueDate])
  @@index([parentType, dueDate])
  @@index([payableId])
  @@index([receivableId])
  @@index([status])
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  action    AuditAction
  resource  String?
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime    @default(now())

  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// === Precificação ===
// Cada "rodada" de precificação (ex.: reajuste de 10%) aplica novos preços ao
// catálogo e fica registrada com o antes/depois para poder ser reutilizada.
model PricingRun {
  id          String           @id @default(uuid())
  label       String
  note        String?
  totalItems  Int              @default(0)
  createdById String?
  createdAt   DateTime         @default(now())

  createdBy   User?            @relation("PricingRuns", fields: [createdById], references: [id], onDelete: SetNull)
  items       PricingRunItem[]

  @@index([createdAt])
}

model PricingRunItem {
  id          String      @id @default(uuid())
  runId       String
  productId   String
  productName String      // snapshot do nome no momento da rodada
  oldPrice    Float
  newPrice    Float

  run         PricingRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([runId])
}

// Ficha de custos e parâmetros de precificação por produto (insumos).
// Valores nulos/zero = ainda não informado; os campos derivados (custo real,
// preço sugerido, mínimo, markup, margem, ponto de equilíbrio) são calculados
// a partir destes campos — ver src/lib/pricing-calc.ts.
model PricingCost {
  id                String   @id @default(uuid())
  productId         String   @unique
  code              String?  @db.VarChar(40)   // Código
  unit              String   @default("UN") @db.VarChar(10) // UN, KG, L, CX...
  supplier          String?  @db.VarChar(120)  // Fornecedor
  purchaseCost      Float?   // Custo de compra (R$/un)
  freight           Float?   // Frete (R$/un)
  otherCosts        Float?   // Outros custos: embalagem, taxas (R$/un)
  additionalCostPct Float?   // Custo adicional %: perdas, tributos de compra
  desiredMarginPct  Float?   // Margem desejada % (sobre o preço)
  taxPct            Float?   // Impostos %
  commissionPct     Float?   // Comissão %
  cardFeePct        Float?   // Taxa cartão %
  marketplaceFeePct Float?   // Taxa marketplace %
  maxDiscountPct    Float?   // Desconto máximo % (limite de negociação)
  fixedCost         Float?   // Custo fixo a recuperar (R$) — p/ ponto de equilíbrio
  notes             String?  @db.VarChar(500)  // Observações
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Status de campanhas de disparo de mensagens

enum CampaignStatus {
  DRAFT
  SENDING
  COMPLETED
  CANCELLED
  FAILED
}

enum RecipientStatus {
  PENDING
  SENT
  ERROR
  CANCELLED
}
// Status de campanhas de disparo de mensagens

model Campaign {
  id          String         @id @default(uuid())
  title       String         @db.VarChar(120)
  message     String         @db.Text
  status      CampaignStatus @default(DRAFT)
  total       Int            @default(0)
  sentCount   Int            @default(0)
  errorCount  Int            @default(0)
  cancelledAt DateTime?
  finishedAt  DateTime?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy  User?              @relation("CampaignsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  recipients CampaignRecipient[]

  @@index([status, createdAt])
  @@index([createdAt])
}
model CampaignRecipient {
  id         String         @id @default(uuid())
  campaignId String
  customerId String?
  name       String         @db.VarChar(120)
  phone      String         @db.VarChar(20)
  message    String         @db.Text
  status     RecipientStatus @default(PENDING)
  error      String?        @db.VarChar(255)
  sentAt     DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer   User?          @relation("CampaignRecipients", fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([campaignId, customerId])
  @@index([campaignId, status])
  @@index([status])
}
