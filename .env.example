# =====================================================================
# Delicias das Estações — variáveis de ambiente
# Copie este arquivo para `.env` na VPS e preencha com seus valores reais.
# NUNCA comite o .env para o repositório (já está no .gitignore).
# =====================================================================

# ---------- Banco de Dados ----------
# Em produção (docker-compose), aponte para o serviço `db`:
#   DATABASE_URL="postgresql://USUARIO:SENHA@db:5432/delicias?schema=public"
# Em desenvolvimento local:
#   DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/delicias?schema=public"
DATABASE_URL="postgresql://postgres:CHANGE_ME@db:5432/delicias?schema=public"

# Para o docker-compose (credenciais do container Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_A_STRONG_PASSWORD
POSTGRES_DB=delicias

# ---------- NextAuth ----------
# Gere uma chave segura com: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_RANDOM_BASE64_SECRET
AUTH_TRUST_HOST=true

# ---------- App ----------
NODE_ENV=production
PORT=3000

# Domínio público (para o NextAuth gerar URLs corretas).
# Ex.: https://deliciasdases.toacoes.com.br
NEXTAUTH_URL=https://seudominio.com.br

# ---------- SSL / Let's Encrypt (se for usar Nginx como proxy reverso) -----
DOMAIN=seudominio.com.br
LE_EMAIL=seu-email@dominio.com.br

# ---------- Google Maps / OSM (se for trocar no futuro) ----------------
# Se for usar Mapbox/Google no futuro, adicione aqui. Hoje usamos
# Leaflet + OpenStreetMap + Nominatim (grátis, sem token).

# ---------- WhatsApp via Evolution API (opcional) ---------------------
# Evolution API é open-source e roda na sua VPS.
# Documentação: https://doc.evolution-api.com
#
# Para subir localmente:
#   docker run -d --name evolution-api \
#     -p 8080:8080 \
#     -e AUTHENTICATION_API_KEY=sua-chave-secreta \
#     atendai/evolution-api:latest
#
# Crie a instância via API:
#   curl -X POST http://localhost:8080/instance/create \
#     -H "apikey: sua-chave-secreta" \
#     -H "Content-Type: application/json" \
#     -d '{"instanceName":"delicias","qrcode":true}'
# Escaneie o QR com seu WhatsApp.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-chave-secreta-aqui
EVOLUTION_INSTANCE=delicias

# Quando as variáveis acima NÃO estiverem definidas, as notificações
# WhatsApp são silenciosamente desativadas (o sistema continua funcionando).

# ---------- Pagamentos via Asaas (opcional) ------------------------
# Sandbox da Asaas: https://sandbox.asaas.com (totalmente grátis p/ testes)
# Para gerar API key: Asaas → Minha Conta → Integrações → API
# Documentação: https://docs.asaas.com/reference
#
# IMPORTANTE: em sandbox, use a chave pública
#   $aact_YTU5YTY0NjgtYjNkYS00N2Y2LWEwNjYtYWQ4YmRl
# ou crie sua conta sandbox gratuita e gere sua própria.
ASAAS_ENV=sandbox                              # sandbox | production
ASAAS_API_KEY=$aact_SUA_CHAVE_AQUI
# ASAAS_WEBHOOK_SECRET=opcional-mas-recomendado-para-producao

# Se as variáveis acima NÃO estiverem configuradas, o sistema
# não mostra a opção de pagamento PIX no checkout (pedido segue
# com pagamento manual na entrega/retirada).